# ─── Database ───────────────────────────────────────
POSTGRES_USER=verbex
POSTGRES_PASSWORD=verbex_secret
POSTGRES_DB=verbex_db
DATABASE_URL=postgresql://verbex:verbex_secret@postgres:5432/verbex_db

# ─── JWT ────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ─── Service Ports ──────────────────────────────────
AUTH_SERVICE_PORT=4001
AGENT_SERVICE_PORT=4002
CHAT_SERVICE_PORT=4003

# ─── Service URLs (inter-service communication) ─────
AUTH_SERVICE_URL=http://auth-service:4001
AGENT_SERVICE_URL=http://agent-service:4002
CHAT_SERVICE_URL=http://chat-service:4003

# ─── LLM APIs ───────────────────────────────────────
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Frontend URLs ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_AUTH_URL=http://localhost/api/auth
NEXT_PUBLIC_CHAT_WIDGET_URL=http://localhost:3001
